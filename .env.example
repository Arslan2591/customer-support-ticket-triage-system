# Copy to .env and adjust. NEVER commit a real .env.
# All settings are optional; sensible defaults are applied in app/config.py.

# Confidence below this routes a ticket to the human-review queue instead of auto-assigning.
TRIAGE_CONFIDENCE_THRESHOLD=0.45

# Optional API key. If set, /triage and /feedback require header:  X-API-Key: <value>
# Leave blank/unset to run the demo without auth.
TRIAGE_API_KEY=

# Paths (defaults point inside ./data). Override only if you need to.
# TRIAGE_DB_PATH=data/triage.db
# TRIAGE_MODEL_PATH=data/model.joblib
# TRIAGE_DATA_CSV=data/tickets.csv

TRIAGE_LOG_LEVEL=INFO
